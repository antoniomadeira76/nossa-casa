{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "ios": "internal",
      "android": "internal"
    },
    "production": {
      "ios": "app-store",
      "android": "google-play"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "asciiOnly": true,
        "metadataPath": "./ios-metadata.json"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
