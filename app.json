{
  "expo": {
    "name": "Nossa Casa",
    "slug": "nossa-casa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#001529",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bengui.nossacasa"
    },
    "android": {
      "package": "com.bengui.nossacasa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#001529"
      }
    },
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      "expo-mail-composer"
    ]
  }
}
